{
  "name": "cedula-aberta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ferramenta pública para o eleitor registrar seus votos e consultar dados oficiais do TSE. M1: pipeline de dados.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fetch": "node scripts/fetch-tse.ts",
    "normalize": "node scripts/normalize.ts",
    "validate": "node scripts/validate.ts",
    "build:data": "npm run fetch && npm run normalize && npm run validate",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run validate && npm run build && npm test",
    "dev": "astro dev",
    "prebuild": "node scripts/copiar-dados.ts",
    "build": "astro build",
    "preview": "astro preview",
    "test:unidade": "node --test \"tests/csv.test.ts\" \"tests/normalizar.test.ts\" \"tests/unzip.test.ts\" \"tests/alertas.test.ts\"",
    "test:navegador": "node --test \"tests/navegador.test.ts\" \"tests/orcamento.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "astro": "^5.18.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
